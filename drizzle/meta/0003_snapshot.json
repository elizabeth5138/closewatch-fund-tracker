      "checkConstraints": {
        "daily_record_status_check": {
          "name": "daily_record_status_check",
          "value": "\"daily_record\".\"status\" IN ('pending', 'priced', 'no_trade', 'suspended', 'not_listed', 'missing')"
        },
        "daily_record_version_check": {
          "name": "daily_record_version_check",
          "value": "\"daily_record\".\"version\" > 0"
        },
        "daily_record_price_check": {
          "name": "daily_record_price_check",
          "value": "\"daily_record\".\"price\" IS NULL OR (\n        typeof(\"daily_record\".\"price\") = 'text'\n        AND instr(\"daily_record\".\"price\", '.') > 1\n        AND length(\"daily_record\".\"price\") - instr(\"daily_record\".\"price\", '.') = 6\n        AND \"daily_record\".\"price\" NOT GLOB '*[^0-9.]*'\n        AND substr(\"daily_record\".\"price\", instr(\"daily_record\".\"price\", '.') + 1) NOT GLOB '*[^0-9]*'\n      )"
        },
        "daily_record_volume_check": {
          "name": "daily_record_volume_check",
          "value": "\"daily_record\".\"volume\" IS NULL OR (\n        typeof(\"daily_record\".\"volume\") = 'text'\n        AND length(\"daily_record\".\"volume\") > 0\n        AND \"daily_record\".\"volume\" NOT GLOB '*[^0-9]*'\n      )"
        },
        "daily_record_state_shape_check": {
          "name": "daily_record_state_shape_check",
          "value": "(\n        (\"daily_record\".\"status\" = 'priced' AND \"daily_record\".\"price\" IS NOT NULL AND \"daily_record\".\"volume\" IS NOT NULL) OR\n        (\"daily_record\".\"status\" = 'no_trade' AND \"daily_record\".\"price\" IS NOT NULL AND \"daily_record\".\"volume\" = '0') OR\n        (\"daily_record\".\"status\" IN ('pending', 'suspended', 'not_listed', 'missing')\n          AND \"daily_record\".\"price\" IS NULL AND \"daily_record\".\"volume\" IS NULL)\n      )"
        }
      }
    },
